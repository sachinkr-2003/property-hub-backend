# Property Hub Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Database URI (Local or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/property_hub_db

# JWT Secret for Session & Tokens
JWT_SECRET=property_hub_super_secret_jwt_key_2026_xyz
JWT_EXPIRE=30d

# Client URLs (CORS whitelist)
ADMIN_CLIENT_URL=http://localhost:5173
MOBILE_CLIENT_URL=http://localhost:3000

# Payment Gateway (Razorpay Keys)
RAZORPAY_KEY_ID=rzp_test_sampleKey123
RAZORPAY_KEY_SECRET=sampleSecretKeyXYZ

# Cloudinary (Free Cloud Media Storage - Leave empty to use local Multer uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
